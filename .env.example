# ==============================================================================
# Environment Configuration (.env.example)
# Real keys never go into git repository.
# ==============================================================================

# Comma-separated key pool, at least 2 keys. Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# SQLite database file path (sqlite:////data/app.db inside Docker volume, or sqlite:///./app.db locally)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS allowed origins for backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# Enables X-Simulate-Failure request header handling for live testing and demonstration
ENABLE_FAILURE_SIMULATION=true

# Model name supported by LiteLLM (e.g. gemini/gemini-2.0-flash, groq/llama-3.3-70b-versatile, openai/gpt-4o-mini)
DEFAULT_MODEL=gemini/gemini-2.0-flash

# Optional: set to true to enable deterministic mock inference when API keys are placeholders
MOCK_LLM=false

# Frontend environment variable (if running Vite frontend directly)
VITE_API_BASE_URL=http://localhost:8000
